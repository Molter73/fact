### https://raw.github.com/github/gitignore/master/Rust.gitignore

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# Python stuff
__pycache__/
.venv/

# gRPC generated files
internalapi/
mock-server/fact_api/
tests/fact_api/

# Files generated by tests
results.xml
logs/
THIRD_PARTY_LICENSES.html
codecov.json

# clangd and compilation database
.cache/
compile_commands.json

# Claude local configuration
.claude/*.local.*

# Object files (generated from manually running clang)
*.o

# Env files
.env
